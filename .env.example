# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Runtime
ENVIRONMENT=dev                 # dev | prod
LOG_LEVEL=INFO

# Storage — SQLite for dev, swap to Postgres for prod by changing this URL only.
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/equity_agent
DATABASE_URL=sqlite:///data/equity_agent.db

# LLM (Phase 2) — Google Gemini (free tier via AI Studio, no card needed)
GOOGLE_API_KEY=
# Optional, only if you buy it later:
# ANTHROPIC_API_KEY=

# Execution broker (Phase 4) — target IBKR (works in Ukraine; uses TWS/Gateway,
# not a simple API key). Defaults live in config.py. Alpaca dropped (not in UA).

# Fundamentals & news (Phase 1) — pick one (both have free tiers)
FINNHUB_API_KEY=
FMP_API_KEY=

# Macro data (Phase 1) — FRED
FRED_API_KEY=

# Error monitoring (Phase 0+) — GlitchTip is Sentry-compatible; paste its DSN
SENTRY_DSN=
