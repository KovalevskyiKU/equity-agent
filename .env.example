# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Runtime
ENVIRONMENT=dev                 # dev | prod
LOG_LEVEL=INFO

# Storage — SQLite for dev, swap to Postgres for prod by changing this URL only.
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/equity_agent
DATABASE_URL=sqlite:///data/equity_agent.db

# LLM providers: comma-separated priority list with failover, e.g. "groq,cerebras".
# Free 70B-class: groq (good daily quota) + cerebras (generous free) stack into more.
# Others: deepseek (needs paid balance), gemini (finicky, ~20/day), ollama (local).
LLM_PROVIDER=groq,cerebras
GROQ_API_KEY=
CEREBRAS_API_KEY=               # free, generous: cloud.cerebras.ai
DEEPSEEK_API_KEY=               # paid — no free balance on our account
GOOGLE_API_KEY=                 # Gemini fallback (low free limit)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Fundamentals & news (Phase 1)
FINNHUB_API_KEY=
FMP_API_KEY=

# Macro (Phase 1) — FRED
FRED_API_KEY=

# Execution broker (Phase 4) — target IBKR (TWS/Gateway). Alpaca dropped (not in UA).

# Error monitoring — GlitchTip/Sentry DSN
SENTRY_DSN=
