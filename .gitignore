# Secrets — ignore every .env variant (incl. stray copies) except the template
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Vendored external repos (cloned by setup step; see README)
third_party/

# Data & artifacts (kept out of git — large / machine-local)
# Anchored to repo root so it does NOT also ignore the src/equity_agent/data/ package.
/data/
*.db
*.sqlite
*.parquet
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
